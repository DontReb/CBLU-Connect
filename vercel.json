{
  "rewrites": [
    { "source": "/:path((?!api/|@|.*\\.).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/documents/upload.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/tesseract.js-core/*.wasm,eng.traineddata}"
    },
    "api/forms/ocr.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/tesseract.js-core/*.wasm,eng.traineddata}"
    }
  }
}
